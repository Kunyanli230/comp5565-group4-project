{
  "name": "provenance-warranty",
  "version": "0.1.0",
  "private": true,
  "description": "Frozen interfaces for the COMP5565 provenance and warranty dApp",
  "scripts": {
    "compile": "hardhat compile",
    "check:interface": "hardhat test test/interface-vectors.js",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "seed:local": "hardhat run scripts/seed.js --network localhost",
    "offchain": "node offchain/server.js",
    "test:offchain": "node --test test/offchain.test.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@types/node": "^22.10.0",
    "chai": "4.5.0",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "2.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "ethers": "^6.14.0"
  }
}

